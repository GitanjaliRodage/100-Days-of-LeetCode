class Solution {
    public List<String> braceExpansionII(String expression) {
        Set<String> result = parse(expression, 0).set;
        List<String> ans = new ArrayList<>(result);
        Collections.sort(ans);
        return ans;
    }

    static class Result {
        Set<String> set;
        int index;

        Result(Set<String> set, int index) {
            this.set = set;
            this.index = index;
        }
    }

    private Result parse(String s, int i) {
        Set<String> result = new HashSet<>();
        Set<String> current = new HashSet<>();
        current.add("");

        while (i < s.length() && s.charAt(i) != '}') {

            if (s.charAt(i) == ',') {
                result.addAll(current);
                current = new HashSet<>();
                current.add("");
                i++;
            } 
            else {
                Result next;

                if (s.charAt(i) == '{') {
                    next = parse(s, i + 1);
                    i = next.index + 1;
                } 
                else {
                    Set<String> single = new HashSet<>();
                    single.add(String.valueOf(s.charAt(i)));
                    next = new Result(single, i + 1);
                    i++;
                }

                current = combine(current, next.set);
            }
        }

        result.addAll(current);
        return new Result(result, i);
    }

    private Set<String> combine(Set<String> a, Set<String> b) {
        Set<String> result = new HashSet<>();

        for (String x : a) {
            for (String y : b) {
                result.add(x + y);
            }
        }

        return result;
    }
}
