class Solution {
    public String lexicographicallySmallestPalindrome(String s, String target) {
        int n = s.length();

        int[] cnt = new int[26];

        for (char c : s.toCharArray()) {
            cnt[c - 'a']++;
        }

        int odd = 0;
        int middle = -1;

        for (int i = 0; i < 26; i++) {
            if (cnt[i] % 2 == 1) {
                odd++;
                middle = i;
            }
        }

        if ((n % 2 == 0 && odd != 0) ||
            (n % 2 == 1 && odd != 1)) {
            return "";
        }

        int[] half = new int[26];

        for (int i = 0; i < 26; i++) {
            half[i] = cnt[i] / 2;
        }

        int len = n / 2;

        for (int pos = len - 1; pos >= 0; pos--) {
            int[] remaining = half.clone();

            boolean possible = true;

            for (int i = 0; i < pos; i++) {
                int ch = target.charAt(i) - 'a';

                if (remaining[ch] == 0) {
                    possible = false;
                    break;
                }

                remaining[ch]--;
            }

            if (!possible) {
                continue;
            }

            int targetChar = target.charAt(pos) - 'a';

            for (int c = targetChar + 1; c < 26; c++) {
                if (remaining[c] == 0) {
                    continue;
                }

                remaining[c]--;

                StringBuilder left = new StringBuilder();

                for (int i = 0; i < pos; i++) {
                    left.append(target.charAt(i));
                }

                left.append((char) ('a' + c));

                for (int x = 0; x < 26; x++) {
                    while (remaining[x] > 0) {
                        left.append((char) ('a' + x));
                        remaining[x]--;
                    }
                }

                return makePalindrome(left.toString(), middle, n);
            }
        }

        int[] remaining = half.clone();
        StringBuilder left = new StringBuilder();

        boolean possible = true;

        for (int i = 0; i < len; i++) {
            int ch = target.charAt(i) - 'a';

            if (remaining[ch] == 0) {
                possible = false;
                break;
            }

            remaining[ch]--;
            left.append((char) ('a' + ch));
        }

        if (possible) {
            String palindrome = makePalindrome(left.toString(), middle, n);

            if (palindrome.compareTo(target) > 0) {
                return palindrome;
            }
        }

        return "";
    }

    private String makePalindrome(String left, int middle, int n) {
        StringBuilder result = new StringBuilder();

        result.append(left);

        if (n % 2 == 1) {
            result.append((char) ('a' + middle));
        }

        result.append(new StringBuilder(left).reverse());

        return result.toString();
    }
}
