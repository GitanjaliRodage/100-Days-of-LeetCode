class Solution {
    public int maximumAmount(int[][] coins) {
        int m = coins.length;
        int n = coins[0].length;

        int NEG = Integer.MIN_VALUE / 2;

        int[][][] dp = new int[m][n][3];

        // Initialize
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int k = 0; k < 3; k++) {
                    dp[i][j][k] = NEG;
                }
            }
        }

        // Starting cell
        dp[0][0][0] = coins[0][0];

        // We can neutralize the starting robber
        if (coins[0][0] < 0) {
            dp[0][0][1] = 0;
        } else {
            dp[0][0][1] = coins[0][0];
        }

        dp[0][0][2] = dp[0][0][1];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (i == 0 && j == 0) {
                    continue;
                }

                for (int k = 0; k < 3; k++) {

                    // Come from top
                    if (i > 0) {
                        dp[i][j][k] = Math.max(
                            dp[i][j][k],
                            dp[i - 1][j][k] + coins[i][j]
                        );

                        // Neutralize this robber
                        if (coins[i][j] < 0 && k > 0) {
                            dp[i][j][k] = Math.max(
                                dp[i][j][k],
                                dp[i - 1][j][k - 1]
                            );
                        }
                    }

                    // Come from left
                    if (j > 0) {
                        dp[i][j][k] = Math.max(
                            dp[i][j][k],
                            dp[i][j - 1][k] + coins[i][j]
                        );

                        // Neutralize this robber
                        if (coins[i][j] < 0 && k > 0) {
                            dp[i][j][k] = Math.max(
                                dp[i][j][k],
                                dp[i][j - 1][k - 1]
                            );
                        }
                    }
                }
            }
        }

        return Math.max(
            dp[m - 1][n - 1][0],
            Math.max(
                dp[m - 1][n - 1][1],
                dp[m - 1][n - 1][2]
            )
        );
    }
}
