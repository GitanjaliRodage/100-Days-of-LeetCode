class Solution {
    public int distinctSubseqII(String s) {
        final int MOD = 1_000_000_007;

        long[] end = new long[26];

        for (char c : s.toCharArray()) {
            int idx = c - 'a';

            long total = 1; // empty subsequence
            for (long x : end) {
                total = (total + x) % MOD;
            }

            end[idx] = total;
        }

        long ans = 0;

        for (long x : end) {
            ans = (ans + x) % MOD;
        }

        return (int) ans;
    }
}
