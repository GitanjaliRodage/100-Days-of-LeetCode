import java.util.*;

class Solution {

    public int[] maximumWeight(List<List<Integer>> intervals) {

        int n = intervals.size();

        int[][] a = new int[n][4];

        for (int i = 0; i < n; i++) {
            a[i][0] = intervals.get(i).get(0); // left
            a[i][1] = intervals.get(i).get(1); // right
            a[i][2] = intervals.get(i).get(2); // weight
            a[i][3] = i;                       // original index
        }

        // Sort by left endpoint
        Arrays.sort(a, (x, y) -> {
            if (x[0] != y[0])
                return Integer.compare(x[0], y[0]);

            return Integer.compare(x[1], y[1]);
        });

        // Find the next non-overlapping interval for every interval
        int[] next = new int[n];

        for (int i = 0; i < n; i++) {

            int low = i + 1;
            int high = n;

            while (low < high) {

                int mid = low + (high - low) / 2;

                if (a[mid][0] > a[i][1]) {
                    high = mid;
                } else {
                    low = mid + 1;
                }
            }

            next[i] = low;
        }

        /*
         * dp[k] = best answer using at most k intervals
         * while processing intervals from right to left.
         */
        State[][] dp = new State[n + 1][5];

        // Initialize EVERY state at n
        for (int k = 0; k <= 4; k++) {
            dp[n][k] = new State(0, new int[0]);
        }

        for (int i = n - 1; i >= 0; i--) {

            // If we can select 0 intervals
            dp[i][0] = new State(0, new int[0]);

            for (int k = 1; k <= 4; k++) {

                // Skip current interval
                State skip = dp[i + 1][k];

                // Take current interval
                State after = dp[next[i]][k - 1];

                int[] selected =
                        new int[after.indices.length + 1];

                // Copy indices
                for (int j = 0; j < after.indices.length; j++) {
                    selected[j] = after.indices[j];
                }

                // Add current original index
                selected[selected.length - 1] = a[i][3];

                // Sort for lexicographical comparison
                Arrays.sort(selected);

                State take = new State(
                        after.score + a[i][2],
                        selected
                );

                dp[i][k] = better(skip, take);
            }
        }

        return dp[0][4].indices;
    }

    static class State {

        long score;
        int[] indices;

        State(long score, int[] indices) {
            this.score = score;
            this.indices = indices;
        }
    }

    static State better(State a, State b) {

        // Maximum score
        if (a.score > b.score) {
            return a;
        }

        if (b.score > a.score) {
            return b;
        }

        // Same score -> lexicographically smaller
        if (lexicographicallySmaller(a.indices, b.indices)) {
            return a;
        }

        return b;
    }

    static boolean lexicographicallySmaller(int[] a, int[] b) {

        int len = Math.min(a.length, b.length);

        for (int i = 0; i < len; i++) {

            if (a[i] != b[i]) {
                return a[i] < b[i];
            }
        }

        return a.length < b.length;
    }
}
