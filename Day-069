class Solution {
    public boolean uniformArray(int[] nums1) {
        int min = nums1[0];

        // Find minimum
        for (int x : nums1) {
            min = Math.min(min, x);
        }

        // If minimum is odd, we can make every element odd.
        if ((min & 1) == 1) {
            return true;
        }

        // Minimum is even.
        // Therefore every element must already be even.
        for (int x : nums1) {
            if ((x & 1) == 1) {
                return false;
            }
        }

        return true;
    }
}
