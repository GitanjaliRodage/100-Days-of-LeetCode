class Solution {
    static class Node {
        int len, pref, suff, best;
        char lc, rc;
    }

    Node[] st;
    char[] arr;

    public int[] longestRepeating(String s, String queryCharacters, int[] queryIndices) {
        int n = s.length();
        arr = s.toCharArray();
        st = new Node[4 * n];
        build(1, 0, n - 1);

        int k = queryIndices.length;
        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            update(1, 0, n - 1, queryIndices[i], queryCharacters.charAt(i));
            ans[i] = st[1].best;
        }
        return ans;
    }

    private void build(int p, int l, int r) {
        st[p] = new Node();
        if (l == r) {
            st[p].len = st[p].pref = st[p].suff = st[p].best = 1;
            st[p].lc = st[p].rc = arr[l];
            return;
        }
        int m = (l + r) >> 1;
        build(p << 1, l, m);
        build(p << 1 | 1, m + 1, r);
        pull(p);
    }

    private void update(int p, int l, int r, int idx, char ch) {
        if (l == r) {
            arr[idx] = ch;
            st[p].lc = st[p].rc = ch;
            st[p].pref = st[p].suff = st[p].best = 1;
            return;
        }
        int m = (l + r) >> 1;
        if (idx <= m) update(p << 1, l, m, idx, ch);
        else update(p << 1 | 1, m + 1, r, idx, ch);
        pull(p);
    }

    private void pull(int p) {
        Node L = st[p << 1], R = st[p << 1 | 1], cur = st[p];

        cur.len = L.len + R.len;
        cur.lc = L.lc;
        cur.rc = R.rc;

        cur.pref = L.pref;
        if (L.pref == L.len && L.rc == R.lc)
            cur.pref = L.len + R.pref;

        cur.suff = R.suff;
        if (R.suff == R.len && L.rc == R.lc)
            cur.suff = R.len + L.suff;

        cur.best = Math.max(L.best, R.best);
        if (L.rc == R.lc)
            cur.best = Math.max(cur.best, L.suff + R.pref);
    }
}
